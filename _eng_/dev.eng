dev
 subcmd
   build
     Builds the demangler library
       exec = cabal build demangler demangle
   test
     testcase
       demangler-test
         type = EXE
         runner = cabal_test
     testrunner
       cabal_test
         exec = cabal test {TestName}

   flake_update =
      Update flake dependencies =
        in dir = {TopDir}
        exec = nix flake update --option tarball-ttl 60

   nixbuild:ancient =
     Uses nix to build versions 8.10 through 9.2
       note = not part of nixbuild:old because 8.10 through 9.6 will exceed
              the available disk space for a github CI runner
       in dir = {TopDir}
       exec =
         nix build --no-link --override-input nixpkgs github:nixos/nixpkgs/25.05  .#demangler.ghc810 .#demangler.ghc90 .#demangler.ghc92
   nixbuild:old =
     Uses nix to build with old GHC versions
       in dir = {TopDir}
       exec = nix build --no-link .#demangler.ghc94 .#demangler.ghc96
   nixbuild:recent =
     Uses nix to build with recent GHC versions
       in dir = {TopDir}
       exec = nix build --no-link .#demangler.ghc98 .#demangler.ghc910
   nixbuild:all =
     Uses nix to build with all supported GHC versions =
       needs = nixbuild:old nixbuild:recent nixbuild
       exec = echo All nix builds completed
   nixbuild =
     Uses nix to build with current GHC versions
       in dir = {TopDir}
       exec = nix build --no-link .#demangler.ghc912
